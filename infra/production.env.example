# Onkofizjo production configuration template.
#
# This file contains placeholders only. Copy it into the approved secret
# manager/configuration service; never commit a filled copy, private keys,
# passwords, tokens or database URLs with credentials.

ONKOFIZJO_ENV=production
ONKOFIZJO_DEMO_MODE=false
ONKOFIZJO_ALLOWED_ORIGINS=https://replace-with-approved-crm.example.eu

# Identity provider. The adapter must verify issuer, audience, JWKS, nonce,
# expiry, revocation/session state and MFA before accepting a request.
ONKOFIZJO_OIDC_ISSUER_URL=https://replace-with-approved-oidc.example.eu/
ONKOFIZJO_OIDC_AUDIENCE=replace-with-approved-api-audience
ONKOFIZJO_MFA_REQUIRED=true
ONKOFIZJO_MFA_AAL=aal2

# Private PostgreSQL. Resolve the credential from the secret manager.
ONKOFIZJO_DATABASE_URL=postgresql://replace-user:replace-password@replace-private-host/onkofizjo
ONKOFIZJO_DATABASE_SSL_MODE=verify-full

# Private encrypted clinical object storage.
ONKOFIZJO_STORAGE_ENDPOINT=https://replace-with-private-storage.example.eu/
ONKOFIZJO_STORAGE_BUCKET=replace-with-private-clinical-bucket
ONKOFIZJO_STORAGE_ENCRYPTION_CONFIRMED=true

# Backups and recovery evidence.
ONKOFIZJO_BACKUP_POLICY_ID=replace-with-approved-backup-policy
ONKOFIZJO_BACKUP_RESTORE_TESTED=true
ONKOFIZJO_BACKUP_ENCRYPTION_CONFIRMED=true

# External append-only audit destination.
ONKOFIZJO_AUDIT_SINK_URL=https://replace-with-immutable-audit.example.eu/onkofizjo

# Versioned governance controls.
ONKOFIZJO_RODO_POLICY_VERSION=replace-with-approved-rodo-policy-version
ONKOFIZJO_RETENTION_POLICY_VERSION=replace-with-approved-retention-policy-version
ONKOFIZJO_DELETION_WORKFLOW_ID=replace-with-approved-deletion-workflow
ONKOFIZJO_INCIDENT_RUNBOOK_VERSION=replace-with-approved-incident-runbook

# Session cookie controls.
ONKOFIZJO_SESSION_COOKIE_SECURE=true
ONKOFIZJO_SESSION_COOKIE_HTTPONLY=true
ONKOFIZJO_SESSION_COOKIE_SAMESITE=Lax
